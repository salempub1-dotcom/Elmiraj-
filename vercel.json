{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/noest", "destination": "/api/noest" },
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/upload-image", "destination": "/api/upload-image" },
    { "source": "/api/delete-image", "destination": "/api/delete-image" },
    { "source": "/api/products", "destination": "/api/products" },
    { "source": "/api/orders", "destination": "/api/orders" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/admin/landing-pages/:id", "destination": "/api/admin/landing-pages/[id]" },
    { "source": "/api/admin/landing-pages", "destination": "/api/admin/landing-pages" },
    { "source": "/api/landing-page/:slug", "destination": "/api/landing-page/[slug]" },

    { "source": "/lp/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([Ff]acebook[Ee]xternal[Hh]it|[Ff]acebot|[Ww]hats[Aa]pp|[Tt]elegram[Bb]ot|[Tt]witter[Bb]ot|[Ll]inked[Ii]n[Bb]ot|[Ss]lackbot|[Dd]iscordbot|[Ss]kype[Uu]ri[Pp]review|[Pp]interest|[Rr]eddit[Bb]ot|[Vv][Kk][Ss]hare).*" }],
      "destination": "/api/products?social_preview=1&id=:id" },
    { "source": "/l/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([Ff]acebook[Ee]xternal[Hh]it|[Ff]acebot|[Ww]hats[Aa]pp|[Tt]elegram[Bb]ot|[Tt]witter[Bb]ot|[Ll]inked[Ii]n[Bb]ot|[Ss]lackbot|[Dd]iscordbot|[Ss]kype[Uu]ri[Pp]review|[Pp]interest|[Rr]eddit[Bb]ot|[Vv][Kk][Ss]hare).*" }],
      "destination": "/api/landing-page/[slug]?social_preview=1&slug=:slug" },

    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
