   }
 };
 
+// ============================================================
+// PHONE CALL LINK — mobile-first "tel:" click-to-call for admin order views
+// ============================================================
+// Sanitizes a displayed phone number for use in a `tel:` href ONLY.
+// Keeps digits and a leading "+"; strips spaces, dashes, parentheses, etc.
+// The number shown to the admin is never altered — only this href value is.
+const sanitizePhoneForTel = (phone: string): string => {
+  const trimmed = (phone || '').trim();
+  const hasLeadingPlus = trimmed.startsWith('+');
+  const digitsOnly = trimmed.replace(/\D/g, '');
+  return `${hasLeadingPlus ? '+' : ''}${digitsOnly}`;
+};
+
+// Compact, high-priority mobile call-to-action used on the main "إدارة
+// الطلبات" order card. Mobile: an obvious tappable pill (≥44px touch
+// target) with a "اتصال" label. Desktop (sm+): shrinks to a subtle inline
+// link — no big button. Printing shows the plain number only (no button).
+const OrderCardPhoneLink = ({ phone, customer }: { phone: string; customer: string }) => (
+  <a
+    href={`tel:${sanitizePhoneForTel(phone)}`}
+    onClick={(e) => e.stopPropagation()}
+    aria-label={`الاتصال بالعميل ${customer} على الرقم ${phone}`}
+    dir="ltr"
+    className="inline-flex items-center gap-1.5 rounded-full font-bold transition-colors
+      min-h-[44px] px-3 py-2 bg-emerald-500/15 text-emerald-300 hover:bg-emerald-500/25 active:bg-emerald-500/30
+      sm:min-h-0 sm:px-0 sm:py-0 sm:bg-transparent sm:text-inherit sm:font-normal sm:gap-1 sm:hover:underline sm:hover:bg-transparent sm:active:bg-transparent"
+  >
+    <span aria-hidden="true">📞</span>
+    <span>{phone}</span>
+    <span className="sm:hidden print:hidden text-[11px] font-extrabold bg-emerald-500 text-white px-2 py-0.5 rounded-full">اتصال</span>
+  </a>
+);
+
+// Subtler click-to-call used in secondary admin views (archive/delivery
+// cards, the recent-orders table). Not a button — just a tappable link with
+// a comfortable hit area.
+const InlinePhoneLink = ({ phone, customer, className = '' }: { phone: string; customer: string; className?: string }) => (
+  <a
+    href={`tel:${sanitizePhoneForTel(phone)}`}
+    onClick={(e) => e.stopPropagation()}
+    aria-label={`الاتصال بالعميل ${customer} على الرقم ${phone}`}
+    dir="ltr"
+    className={`inline-flex items-center -my-1 py-1 hover:underline focus:underline ${className}`}
+  >
+    {phone}
+  </a>
+);
+
 // ============================================================
 // SMALL COMPONENTS
 // ============================================================
